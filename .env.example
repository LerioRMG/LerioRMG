# =============================================================================
# Honey Garden CRM - Variabili d'ambiente
# Copia questo file in .env e valorizza i campi prima di avviare il progetto.
# NON committare mai il file .env con segreti reali.
# =============================================================================

# --- Ambiente ------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Usata dal frontend Next.js (deve iniziare con NEXT_PUBLIC_ per essere esposta al browser)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Database (PostgreSQL) ------------------------------------------------
POSTGRES_USER=honeygarden
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=honeygarden
POSTGRES_PORT=5432
DATABASE_URL=postgresql://honeygarden:change_me_dev_password@localhost:5432/honeygarden?schema=public

# --- Redis (job queue / cache) --------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Autenticazione / sicurezza -------------------------------------------
# Genera stringhe casuali robuste, es: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Chiave per la cifratura AES-256-GCM delle credenziali provider (32 byte hex = 64 caratteri)
CREDENTIALS_ENCRYPTION_KEY=replace_with_64_hex_chars_32_bytes_key
COOKIE_DOMAIN=localhost

# --- Seed iniziale (Owner) -------------------------------------------------
SEED_OWNER_EMAIL=owner@honeygarden.local
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_ORGANIZATION_NAME="Honey Garden"

# --- Provider OnlyFans (opzionali - se assenti il CRM mostra "Provider non configurato") ---
PROVIDER_API_1_BASE_URL=
PROVIDER_API_1_API_KEY=
PROVIDER_API_2_BASE_URL=
PROVIDER_API_2_API_KEY=

# --- AI (opzionale - se assente le funzioni AI restano disattivate) --------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Email transazionali (opzionale - se assente si usa un transport di log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Honey Garden CRM <no-reply@honeygarden.local>"

# --- Storage media (compatibile S3, opzionale - MinIO in docker-compose) --
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=honeygarden
S3_SECRET_KEY=change_me_dev_password
S3_BUCKET=honeygarden-media
S3_FORCE_PATH_STYLE=true

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
